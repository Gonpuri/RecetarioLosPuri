# Variables de entorno del backend. En Render se cargan en el panel del
# servicio; este archivo solo documenta cuales hacen falta.

# Obligatorias
SECRET_KEY=generar-una-clave-larga-y-aleatoria
DEBUG=False
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Dominio del front en Vercel, separados por coma
CORS_ALLOWED_ORIGINS=https://sgrf.vercel.app
CSRF_TRUSTED_ORIGINS=https://sgrf.vercel.app

# Administrador inicial (lo crea build.sh en el primer despliegue)
ADMIN_CORREO=admin@familia.test
ADMIN_CLAVE=una-clave-segura
ADMIN_NOMBRE=Administrador

# Fotografias
CLOUDINARY_URL=cloudinary://clave:secreto@nombre-cuenta

LOG_LEVEL=INFO
